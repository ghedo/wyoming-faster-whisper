# ROCm variant of the CPU image in ./Dockerfile.
#
# Not published to Docker Hub. Build it locally:
#
#   docker build -f Dockerfile.ROCm -t wyoming-whisper:rocm .
#
# This image is amd64 only. It uses AMD's matched ROCm 10 image, which ships
# PyTorch, ONNX Runtime, and the MIGraphX execution provider (EP) already
# installed in /opt/venv, plus CTranslate2's official ROCm wheel. PyTorch and
# CTranslate2 expose AMD GPUs through their "cuda" APIs; the server's
# user-facing "rocm" device translates that while selecting MIGraphX for ONNX.
#
# MIGraphX is no longer built into onnxruntime: since ROCm 7.2 it ships as the
# separate `onnxruntime-ep-migraphx` plugin, which the server registers at
# startup (wyoming_faster_whisper.device). That plugin also fixed a bug in the
# bundled-EP builds where dynamically-shaped models with external weight files
# (qwen3-asr's encoder) failed on the first transcription with
# "Failure opening file: encoder.int4.onnx.data" - the EP re-parsed the graph
# at runtime without pointing MIGraphX at the model's directory.
#
# ROCm 10.1 and earlier are not usable for qwen3-asr: their MIGraphX (2.17/2.18)
# only accepted the 1-D `zero_points` layout in MatMulNBits, while the
# qwen3-asr int4 graphs use the 2-D `com.microsoft` layout, so every
# quantized node made the EP fail and the decoder silently ran on the CPU.
# ROCm 10.2 ships MIGraphX 2.19.0, which accepts both layouts.
#
# sherpa-onnx stays on the CPU. Its ROCm execution provider is still an unmerged
# upstream change, and the published Python wheels have no ROCm support. The
# server logs a warning and uses sherpa's CPU provider instead.
ARG ROCM_VERSION=10.2.0
ARG BASE_TAG=rocm${ROCM_VERSION}_ub24.04_ort1.29_torch2.14.0_py3.12
FROM rocm/onnxruntime:${BASE_TAG}

ARG ROCM_VERSION
ARG CTRANSLATE2_VERSION=4.9.1
# The ROCm wheel targets libamdhip64.so.7, which ROCm 10 still provides (HIP
# did not bump its soname), so the ROCm-7-era wheel loads unchanged.
ARG CTRANSLATE2_WHEELS_SHA256=283c6800475961a13120f8ad2761a00ebe645aac3c155a6794f6d784b1111593

WORKDIR /usr/src

COPY ./pyproject.toml ./
RUN \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        openmpi-bin \
        unzip \
        wget \
    \
    # Reuse the base image's environment instead of downloading second copies
    # of its multi-gigabyte ROCm PyTorch, ONNX Runtime, and MIGraphX EP
    # installations.
    && ln -s /opt/venv .venv \
    && .venv/bin/pip3 install --no-cache-dir -U \
        setuptools \
        wheel \
    \
    # ROCm wheels are release assets rather than PyPI packages. Extract only
    # the wheel matching the base image's Python interpreter.
    && wget -q \
        "https://github.com/OpenNMT/CTranslate2/releases/download/v${CTRANSLATE2_VERSION}/rocm-python-wheels-Linux.zip" \
        -O /tmp/ctranslate2-rocm.zip \
    && echo "${CTRANSLATE2_WHEELS_SHA256}  /tmp/ctranslate2-rocm.zip" \
        | sha256sum --check - \
    && mkdir /tmp/ctranslate2-rocm \
    && unzip -j -q /tmp/ctranslate2-rocm.zip \
        '*cp312*manylinux*x86_64.whl' -d /tmp/ctranslate2-rocm \
    && .venv/bin/pip3 install --no-cache-dir /tmp/ctranslate2-rocm/*.whl \
    \
    # The base image already provides onnxruntime 1.29 (ROCm core) and the
    # onnxruntime-ep-migraphx plugin, and onnxruntime>=1.18.1 is satisfied by
    # it, so the extras do not disturb either. torch is satisfied by the
    # base image's torch 2.14+rocm10.2.0, so no CPU torch is pulled.
    && .venv/bin/pip3 install --no-cache-dir \
        -e '.[zeroconf,transformers,funasr,sherpa,onnx-asr,qwen3-asr,hass]' \
    \
    && rm -rf \
        /tmp/ctranslate2-rocm \
        /tmp/ctranslate2-rocm.zip \
        /var/lib/apt/lists/*

COPY ./ ./

# CTranslate2's default GPU allocator (hipMallocAsync memory pools) silently
# corrupts buffers on consumer RDNA GPUs after the first inference: the first
# transcription is correct, later ones come back as garbage or crash.
# hipcub's caching allocator is immune and is at least as fast, so make it the
# image default. Users can override with CT2_CUDA_ALLOCATOR=cuda_malloc_async.
# See OpenNMT/CTranslate2#1072, #2012, #2021, #2038, #2090 and
# ROCm/rocm-systems#10943.
#
# The base image's LD_LIBRARY_PATH is /opt/rocm/lib:/opt/rocm/lib/rocm_sysdeps/lib.
# Prepend the ROCm LLVM lib dir the way the previous image did: the CTranslate2
# and torch ROCm builds resolve some LLVM symbols through it.
#
# HF_HOME/XDG_CACHE_HOME/MODELSCOPE_CACHE keep the library caches on the /data
# volume; see the CPU image for why they have to be set here and not in Python.
ENV LD_LIBRARY_PATH=/opt/rocm/lib/llvm/lib:/opt/rocm/lib:/opt/rocm/lib/rocm_sysdeps/lib \
    STT_DEVICE=rocm \
    CT2_CUDA_ALLOCATOR=cub_caching \
    HF_HOME=/data \
    XDG_CACHE_HOME=/data \
    MODELSCOPE_CACHE=/data/modelscope

EXPOSE 10300

# See the CPU image for why this is a Describe/Info round trip and why the start
# period is this long.
HEALTHCHECK --interval=30s --timeout=20s --start-period=5m --retries=3 \
    CMD ["/usr/src/.venv/bin/python3", "-m", "wyoming_faster_whisper.health_check"]

ENTRYPOINT ["bash", "docker_run.sh"]
